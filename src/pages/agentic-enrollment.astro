---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

// Unlisted concept page: reachable only by direct URL.
const page = await getEntry("pages", "agentic-enrollment");
if (!page) throw new Error('Missing content entry "agentic-enrollment"');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description} noindex={page.data.noindex}>
  <Content />
</BaseLayout>
